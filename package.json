{
  "name": "@rve/tiptap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "src/styles/content.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./styles/content.css": "./src/styles/content.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "typescript": "~6.0.2"
  }
}
